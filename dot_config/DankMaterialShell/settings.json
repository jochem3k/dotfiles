      "currentFileExtension": "txt",
      "sourceContent": "services:\n  crafty:\n    container_name: crafty\n    image: registry.gitlab.com/crafty-controller/crafty-4:${CRAFTY_TAG}\n    restart: unless-stopped\n    #deploy:\n    # resources:\n    #   limits:\n    #     cpus: '3'\n    #     memory: 8gb\n    #   reservations:\n    #     cpus: '2'\n    #     memory: 6gb\n    env_file:\n      - .env\n    networks:\n      - traefik\n    ports:\n      - 8000:8000 # HTTP\n      - 8443:8443 # HTTPS\n      - 8123:8123 # BlueMap\n      - 25500-25600:25500-25600 # MC SERV PORT RANGE\n    volumes:\n      - crafty:/crafty/backups\n      - crafty_logs:/crafty/logs\n      - crafty_servers:/crafty/servers\n      - crafty_config:/crafty/app/config\n      - crafty_import:/crafty/import\n    labels:\n      - \"traefik.enable=true\"\n      - \"traefik.http.services.crafty.loadbalancer.server.port=8443\"\n      - \"traefik.http.services.crafty.loadbalancer.server.scheme=https\"\n      - \"traefik.http.routers.crafty-https.entrypoints=websecure\"\n      - \"traefik.http.routers.crafty-https.rule=Host(`crafty.int.shibelab.xyz`)\"\n      - \"traefik.http.routers.crafty-https.tls=true\"\n      - \"traefik.http.routers.crafty-https.tls.certresolver=cloudflare\"\n      - \"traefik.http.middlewares.whitelist.ipallowlist.sourcerange=192.168.2.0/24\"\n      - \"traefik.http.middlewares.sslheader.headers.customrequestheaders.X-Forwarded-Proto = https\"\n      - homepage.group=Services\n      - homepage.name=Crafty\n      - homepage.icon=minecraft.png\n      - homepage.href=https://crafty.int.shibelab.xyz\n      - homepage.widget.type=minecraft\n      - homepage.widget.url=udp://192.168.2.250:25565\n      - homepage.widget.fields=[\"status\", \"version\"]\n      - homepage.weight=400\nvolumes:\n  crafty:\n    external: true\n  crafty_logs:\n    external: true\n  crafty_servers:\n    external: true\n  crafty_config:\n    external: true\n  crafty_import:\n    external: true\nnetworks:\n  traefik:\n    external: true\n",
