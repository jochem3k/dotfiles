{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    // We use a clean chevron with explicit spacing so it never glues to values
    "separator": " 󰄾  ",
    "key": {
      // Setting width to 0 disables Fastfetch's broken auto-padding calculation
      "width": 0,
    },
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────┐",
    }, 
    {
      "type": "command",
      "key": "  󰡨 Image     ",
      "keyColor": "blue",
      "text": "img=$(cat /usr/share/calx/image-name 2>/dev/null || echo 'unknown'); if grep -qE 'sigstoreSigned|signedBy' /etc/containers/policy.json 2>/dev/null; then echo \"$img 🔐\"; else echo \"$img 🔓\"; fi",
      "shell": "/bin/bash"
    },
    {
      "type": "command",
      "key": "  󰃭 Build     ",
      "keyColor": "blue",
      "text": "ts=$(cat /usr/share/calx/build-timestamp 2>/dev/null); b=$(if [ -n \"$ts\" ]; then date -d \"$ts\" +'%b %d %Y'; else echo 'unknown'; fi); s=$(rpm-ostree status --json 2>/dev/null | python3 -c \"import sys, json; d = json.load(sys.stdin)['deployments']; digest = d[0].get('container-image-reference-digest', '').removeprefix('sha256:') or d[0]['checksum']; print('staged (reboot pending)' if d[0].get('staged') else digest[:12] + ' (up to date)')\" 2>/dev/null); echo \"$b · $s\"",
      "shell": "/bin/bash"
    },
    {
      "type": "command",
      "key": "  󰣛 OS        ",
      "keyColor": "blue",
      "text": "echo \"$(. /etc/os-release && echo \"$NAME $VERSION_ID\") $(uname -m)\"",
      "shell": "/bin/bash"
    },
    {
      "type": "kernel",
      "key": "   Kernel    ",
      "keyColor": "bright_blue",
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime    ",
      "keyColor": "bright_blue",
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages  ",
      "keyColor": "bright_blue",
    },
    {
      "type": "shell",
      "key": "   Shell     ",
      "keyColor": "cyan",
    },
    {
      "type": "de",
      "key": "  󰕮 DE        ",
      "keyColor": "cyan",
    },
    {
      "type": "wm",
      "key": "   WM        ",
      "keyColor": "cyan",
    },
    {
      "type": "terminal",
      "key": "  󰆍 Terminal  ",
      "keyColor": "cyan",
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU       ",
      "keyColor": "bright_yellow",
    },
    {
      "type": "gpu",
      "key": "  󰘚 GPU       ",
      "keyColor": "bright_yellow",
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory    ",
      "keyColor": "bright_yellow",
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "󰮯",
    },
  ],
}
