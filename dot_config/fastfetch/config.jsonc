{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ==========================================
  // ACTIVE BLUESHIFT LOGO
  // ==========================================
  "logo": {
    "source": "~/.config/fastfetch/blueshift.txt",
    "color": {
      "1": "blue",
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4,
    },
  },

  "display": {
    // We use a clean chevron with explicit spacing so it never glues to values
    "separator": " 󰄾  ",
    "key": {
      // Setting width to 0 disables Fastfetch's broken auto-padding calculation
      "width": 0,
    },
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────┐",
    },
    {
      "type": "command",
      "key": "  󰡨 Image     ",
      "keyColor": "blue",
      "text": "line=$(rpm-ostree status | grep '●'); clean=$(echo \"$line\" | sed -E 's#^.*(://|registry:)##' | sed -E 's#[^/]*/[^/]*/##'); if echo \"$line\" | grep -q 'unverified'; then echo \"$clean 🔓\"; else echo \"$clean \"; fi",
      "shell": "/bin/bash",
    },
    {
      "type": "command",
      "key": "  󰃭 Build     ",
      "keyColor": "blue",
      "text": "btime=$(rpm-ostree status | grep -A 2 '●' | awk -F'[(|)]' '/Version/ {print $2}'); if [ -n \"$btime\" ]; then date -d \"$btime\" +'%b %d %Y'; else echo 'Unknown'; fi",
      "shell": "/bin/bash",
    },
    {
      "type": "command",
      "key": "  󰣛 OS        ",
      "keyColor": "blue",
      "text": "echo \"Blueshift $(awk -F= '/VERSION_ID/ {print $2}' /etc/os-release | tr -d '\"') (Fedora Atomic) $(uname -m)\"",
      "shell": "/bin/bash",
    },
    {
      "type": "kernel",
      "key": "   Kernel    ",
      "keyColor": "bright_blue",
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime    ",
      "keyColor": "bright_blue",
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages  ",
      "keyColor": "bright_blue",
    },
    {
      "type": "shell",
      "key": "   Shell     ",
      "keyColor": "cyan",
    },
    {
      "type": "wm",
      "key": "   WM        ",
      "keyColor": "cyan",
    },
    {
      "type": "terminal",
      "key": "  󰆍 Terminal  ",
      "keyColor": "cyan",
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU       ",
      "keyColor": "bright_yellow",
    },
    {
      "type": "gpu",
      "key": "  󰘚 GPU       ",
      "keyColor": "bright_yellow",
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory    ",
      "keyColor": "bright_yellow",
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "󰮯",
    },
  ],
}
