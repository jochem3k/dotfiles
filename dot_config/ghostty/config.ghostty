# Ghostty Configuration
# Generated by Ventz's Ghostty Settings Generator
# https://github.com/ventz/ghostty-settings-visual-config

# Font family to use
# Options: String: font name
font-family = "JetBrains Mono"

# Color theme name or path
# Options: String
theme = rietveld-black

# Window height in cells
# Options: Number
window-height = 50

# Window width in cells
# Options: Number
window-width = 130

# Enable VSync
# Options: Boolean
window-vsync = true

# Confirm before closing
# Options: Boolean
confirm-close-surface = true

# Trim spaces when copying
# Options: Boolean
clipboard-trim-trailing-spaces = true

# Paste protection warning
# Options: Boolean
clipboard-paste-protection = true

# Safe bracketed paste
# Options: Boolean
clipboard-paste-bracketed-safe = true

# Allow desktop notifications
# Options: Boolean
desktop-notifications = true

# Enable window shadow
# Options: Boolean
macos-window-shadow = true

# Auto secure keyboard input
# Options: Boolean
macos-auto-secure-input = true

# Show secure input indicator
# Options: Boolean
macos-secure-input-indication = true

# Auto-hide on focus lost
# Options: Boolean
quick-terminal-autohide = true

# Custom keybinding
# Options: trigger=action
keybind = ctrl+shift+[=goto_split:previous

# Custom keybinding
# Options: trigger=action
keybind = ctrl+shift+]=goto_split:next

# Custom keybinding
# Options: trigger=action
keybind = ctrl+super+[=unbind

# Custom keybinding
# Options: trigger=action
keybind = ctrl+super+]=unbind

# Custom keybinding
# Options: trigger=action
keybind = ctrl+shift+w=close_surface

#gtk-titlebar = false  # disabled by ghostty-config: back to the default
