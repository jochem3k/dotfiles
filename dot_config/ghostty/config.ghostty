# Appearance
font-family = "JetBrains Mono"
theme = "Adwaita Dark"
window-height = 50
window-width = 170
window-vsync = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

# Behaviour
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
confirm-close-surface = true
desktop-notifications = true

# Keybindings
# --- Split Creation ---
# Auto-split along the larger dimension (smart aspect ratio split)
keybind = ctrl+shift+enter=new_split:auto
# Explicit vertical / horizontal splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down

# --- Split Navigation ---
# Cycle adjacent splits
keybind = ctrl+shift+[=goto_split:previous
keybind = ctrl+shift+]=goto_split:next
# Direct directional jumps (Vim or Arrow style)
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down

# --- Split Utility & Resizing ---
# Temporarily maximize active split to read wide logs, then restore
keybind = ctrl+shift+z=toggle_split_zoom
# Reset all split widths/heights evenly
keybind = ctrl+shift+=equalize_splits
# Resize active split (steps of 20px)
keybind = ctrl+alt+left=resize_split:left,20
keybind = ctrl+alt+right=resize_split:right,20
keybind = ctrl+alt+up=resize_split:up,20
keybind = ctrl+alt+down=resize_split:down,20

# Close focused split surface
keybind = ctrl+shift+w=close_surface
