// Generated by niri-settings - Edits will be overwritten!

prefer-no-csd

overview {
    zoom 0.4
}

animations {
    on
    slowdown 0.9
}

layout {
    always-center-single-column
    shadow {
    on
    }

    gaps 10
    default-column-display "tabbed"
    center-focused-column "never"
    // empty-workspace-above-first

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    focus-ring {
        on
        width 3
        active-color "#3584e4"
        inactive-color "#505050"
    }

    border {
        off
        width 3
        active-color "#3584e4"
        inactive-color "#505050"
    }

    insert-hint {
        // off
        color "#ffc87f70"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        corner-radius 4
        width 4
        length total-proportion=1.0
        gap 4
        gaps-between-tabs 2
    }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
    highlight {
        corner-radius 12
        active-color "#2e2e32"
        urgent-color "#c01c28"
    }
}

input {
    // warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="25%"
    // disable-power-key-handling
    workspace-auto-back-and-forth
    mod-key "Super"

    touchpad {
        tap
        // dwt
        // dwtp
        natural-scroll
        drag false
        // drag-lock
        // disabled-on-external-mouse
        // left-handed
        click-method "clickfinger"
        scroll-method "two-finger"
        accel-speed 0.17
        accel-profile "adaptive"
        tap-button-map "left-right-middle"
        scroll-factor 1.0
    }

    mouse {
        // natural-scroll
        // left-handed
        // middle-emulation
        accel-speed 0.20
        accel-profile "adaptive"
        scroll-factor 1.0
    }

    keyboard {
        track-layout "window"
        xkb {}
        numlock
        repeat-delay 600
        repeat-rate 25
    }
}

hotkey-overlay {
    hide-not-bound
    skip-at-startup
    }

gestures {
    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }
    dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }
    hot-corners {
        top-left
    }
}

debug {
    honor-xdg-activation-with-invalid-serial
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
    // hide-when-typing
    // hide-after-inactive-ms {self.behavior_tab.inactive_spinbox.value()}
}
