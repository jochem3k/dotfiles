// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "global_lsp_settings": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "terminal": {
    "dock": "left"
  },
  "window_title_format": "${projectName}${separator}${fileName}",
  "cli_default_open_behavior": "existing_window",
  "ui_font_family": "Adwaita Sans",
  "buffer_font_family": "Adwaita Mono",
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "right"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Adwaita Light",
    "dark": "Adwaita Dark",
  },
}
