# --- 1. Environment Variables ---
export ZSH="$HOME/.oh-my-zsh"
export EDITOR="fresh"
export VISUAL="fresh"
export BAT_THEME="Catppuccin Mocha"
export LS_COLORS="$(vivid generate ansi)"

# --- 2. Oh My Zsh Configuration ---
ZSH_THEME="robbyrussell"
ENABLE_CORRECTION="true"
plugins=(git docker zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# --- 3. Tool Initialization ---
# zoxide
eval "$(zoxide init zsh --cmd cd)"

# spicetify
export PATH=$PATH:/home/jochem/.spicetify

# --- 4. Aliases ---
# Core Replacements
alias f='fresh'
alias cat='bat'
alias df='duf'
alias du='dust'
alias ls='eza -alh --icons --group-directories-first --git --header --octal-permissions --color=auto'
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -I --preserve-root'
alias mkdir='mkdir -p'
alias z='zeditor'
alias top='dgop'

# --- 5. SSH ---
# If we're in Ghostty, tell remote servers we're just a standard xterm
if [[ "$TERM" == *ghostty* ]]; then
    alias ssh="TERM=xterm-256color ssh"
fi

# Aliases
alias d0='ssh docker@192.168.2.250'
alias hy='ssh hytale@192.168.2.240'
alias pmb='ssh protonmail-bridge@192.168.2.211'
alias tailsc='ssh tailscale@192.168.2.213'
alias dns='ssh dns@192.168.2.253'

# --- 6. Eye Candy ---
# Only run fastfetch if the session is interactive
[[ $- == *i* ]] && fastfetch
